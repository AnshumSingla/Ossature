# Copy to .env.local
# --- On-device speech-to-text (runs in the browser; audio never leaves the device) - all optional ---
# Model + the pinned commit of its repo. Default: Whisper tiny.en (~41 MB). Moonshine tiny is a
# faster, less accurate alternative: onnx-community/moonshine-tiny-ONNX @ a6da1241cd305dcd64eab1edbd615f2bb9aabb95
# VITE_STT_MODEL_ID=onnx-community/whisper-tiny.en
# VITE_STT_MODEL_REVISION=2575352d61be1bf7225cf8f8b268a4678025fc58
# Self-host the model files instead of fetching from Hugging Face (files at <host>/<model id>/...).
# VITE_STT_MODEL_HOST=/models
# Approximate download size in bytes, used only to draw an honest progress bar (default 41000000).
# VITE_STT_MODEL_BYTES=41000000
# Download the model in the background as soon as the site opens (default true). Set to false to
# only download when someone first presses "Start mic".
# VITE_STT_PRELOAD=true
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws/interview
