# Copy to .env and fill in. Consumed by docker-compose and the services.

# --- Postgres ---
POSTGRES_DB=ossature
POSTGRES_USER=ossature
POSTGRES_PASSWORD=ossature
POSTGRES_PORT=5432

# --- Database roles (created by migration V7) ---
# POSTGRES_USER above is the schema OWNER: used only to run migrations, never by the running app.
# The backend connects as ossature_app (no DDL, no BYPASSRLS, subject to row-level security) and
# the agent as ossature_agent (only its own table). Row-level security does not protect an
# account that can run arbitrary SQL, so in production give each its own strong secret;
# the backend refuses to start with the development defaults when APP_ENV=prod.
APP_DB_USER=ossature_app
APP_DB_PASSWORD=ossature_app
AGENT_DB_USER=ossature_agent
AGENT_DB_PASSWORD=ossature_agent

# --- pgAdmin (optional dev tool) ---
PGADMIN_DEFAULT_EMAIL=dev@ossature.local
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
AGENT_BASE_URL=http://localhost:8000

# --- Agent (LangGraph service) ---
AGENT_PORT=8000
# LLM provider key. The agent is provider-agnostic; OpenAI wired by default.
OPENAI_API_KEY=
# Model tiers (see PRD ss8 cost notes): cheap for high-frequency work,
# stronger models reserved for the once-per-session Council/Review passes.
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_COUNCIL_GENERATOR=gpt-4o
LLM_MODEL_COUNCIL_CRITIC=gpt-4o
LLM_MODEL_REVIEW=gpt-4o

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws/interview
