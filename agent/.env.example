# Copy to .env (loaded via pydantic-settings).

AGENT_PORT=8000

# LLM provider. Leave OPENAI_API_KEY blank to run the graph in stub mode
# (deterministic placeholder text, no network calls) for local wiring.
OPENAI_API_KEY=
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_COUNCIL_GENERATOR=gpt-4o
LLM_MODEL_COUNCIL_CRITIC=gpt-4o
LLM_MODEL_REVIEW=gpt-4o

# Optional LangSmith tracing (PRD 8, observability).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ossature-interviewer

# Same Postgres instance the backend uses (docker-compose `postgres` service), for
# session-state durability only (app/store.py). The agent connects as the restricted
# `ossature_agent` role, created together with its `agent_sessions` table by the backend's
# migration V7 (start the backend once first). Never use the schema owner (POSTGRES_USER) here.
# If Postgres is unreachable the agent falls back to in-memory-only state (no crash).
DB_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_DB=ossature
AGENT_DB_USER=ossature_agent
# Public development default; with APP_ENV=prod the agent refuses to start on it. Must match the
# backend's AGENT_DB_PASSWORD (the backend's migration sets the role's password from it).
AGENT_DB_PASSWORD=ossature_agent

# "dev" (default) or "prod". With prod the agent refuses to start unless INTERNAL_AUTH_TOKEN and AGENT_DB_PASSWORD are set.
APP_ENV=dev

# Shared secret checked against the backend's X-Internal-Token header (see app/security.py
# and backend's AGENT_SHARED_SECRET). Blank = no check, open for local dev - set both sides
# together before deploying anywhere the agent is reachable by more than the backend.
INTERNAL_AUTH_TOKEN=
